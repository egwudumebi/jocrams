# Jocrams — Docker production environment
# Copy to .env.docker and customize before running docker compose

APP_NAME=Jocrams
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning

# PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=jocrams
DB_USERNAME=jocrams
DB_PASSWORD=change_me_in_production

# Redis — cache, queue, sessions
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
CACHE_PREFIX=jocrams_cache_
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@jocrams.test"
MAIL_FROM_NAME="${APP_NAME}"

# Payments
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
PAYMENT_CALLBACK_URL="${APP_URL}/payments/callback"
PAYMENT_DEFAULT_GATEWAY=paystack
PAYMENT_CURRENCY=NGN

DOWNLOAD_SIGNED_URL_TTL=15
DOWNLOAD_PRIVATE_DISK=local

SMS_DRIVER=log

RUN_MIGRATIONS=true
