APP_NAME=Jocrams
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# cPanel staging: use bundled database/database.sqlite (see .env.cpanel.example)
# Production (Docker): DB_CONNECTION=pgsql, DB_HOST=postgres
# Production (cPanel): DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=jocrams
# DB_USERNAME=jocrams
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Production (Docker): SESSION_DRIVER=redis, CACHE_STORE=redis, QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
PAYMENT_CALLBACK_URL="${APP_URL}/member/payments"
PAYMENT_DEFAULT_GATEWAY=manual
PAYMENT_CURRENCY=NGN
DOWNLOAD_SIGNED_URL_TTL=15

SWAGGER_DOCS_ENABLED=true
SWAGGER_TITLE="Jocrams API"
SWAGGER_DESCRIPTION="Interactive OpenAPI documentation for the Jocrams API."
SWAGGER_VERSION=1.0.0
SWAGGER_DOCS_PATH=docs
SWAGGER_OPENAPI_PATH=docs/openapi.json
SWAGGER_SERVERS="${APP_URL}"

MONITOR_INTERVAL_SECONDS=60
MONITOR_APP_URL="${APP_URL}"
